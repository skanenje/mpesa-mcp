# M-Pesa Daraja API Credentials
# Get these from https://developer.safaricom.co.ke/

# Consumer Key and Secret (from your Daraja app)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Base URL (Sandbox vs Production)
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
BASE_URL=https://sandbox.safaricom.co.ke

# STK Push Configuration
# Business Shortcode (for sandbox, this is usually 174379)
BUSINESS_SHORTCODE=174379

# Passkey (get this from your Daraja test credentials page)
PASSKEY=your_passkey_here

# Callback URL (where M-Pesa will send payment notifications)
# For development, you can use a service like ngrok or webhook.site
CALLBACK_URL=https://your-callback-url.com/mpesa/callback

# Account Reference (appears on customer's phone)
ACCOUNT_REFERENCE=PaymentRef

# Optional: For production, add these
# SHORTCODE_TYPE=paybill or till